#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    /*
     * Combos:
     *
     *   0 + .                  -> studio_unlock (öppna ZMK Studio)
     *   NumLock + 0 + Enter    -> bootloader   (tvinga DFU-läge utan RST-pinnar)
     *
     * Position-ordningen är visuell, 0-indexerad:
     *   0=NumLock 1=/   2=*  3=Del   4=7  5=8  6=9  7=-
     *   8=4 9=5 10=6 11=+   12=1 13=2 14=3 15=Enter   16=0 17=.
     */
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <75>;
            key-positions = <16 17>;
            bindings = <&studio_unlock>;
        };

        combo_bootloader {
            timeout-ms = <100>;
            key-positions = <0 15 16>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
            bindings = <
                &kp KP_NUMLOCK  &kp KP_SLASH  &kp KP_MULTIPLY  &kp DEL
                &kp KP_N7       &kp KP_N8     &kp KP_N9        &kp KP_MINUS
                &kp KP_N4       &kp KP_N5     &kp KP_N6        &kp KP_PLUS
                &kp KP_N1       &kp KP_N2     &kp KP_N3        &kp KP_ENTER
                &kp KP_N0                     &kp DOT
            >;
        };

        layer_1 {
            display-name = "Layer 1";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans          &trans
            >;
        };

        layer_2 {
            display-name = "Layer 2";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans          &trans
            >;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans          &trans
            >;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans          &trans
            >;
        };
    };
};
