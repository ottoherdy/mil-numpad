#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    /*
     * Combos:
     *
     *   0 + .                  -> studio_unlock (öppna ZMK Studio)
     *   NumLock + 0 + Enter    -> bootloader   (tvinga DFU-läge utan RST-pinnar)
     *
     * Position-ordningen är visuell, 0-indexerad:
     *   0=NumLock 1=/   2=*  3=Del   4=7  5=8  6=9  7=-
     *   8=4 9=5 10=6 11=+   12=1 13=2 14=3 15=Enter   16=0 17=.
     */
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <75>;
            key-positions = <16 17>;
            bindings = <&studio_unlock>;
        };

        combo_bootloader {
            timeout-ms = <100>;
            key-positions = <0 15 16>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
            /*
             * NumLock är nu en HOLD-TAP:
             *   - tryck snabbt    -> Num Lock (som vanligt)
             *   - håll inne       -> aktiverar BLE-layern så länge du håller
             */
            bindings = <
                &lt 1 KP_NUMLOCK  &kp KP_SLASH  &kp KP_MULTIPLY  &kp DEL
                &kp KP_N7         &kp KP_N8     &kp KP_N9        &kp KP_MINUS
                &kp KP_N4         &kp KP_N5     &kp KP_N6        &kp KP_PLUS
                &kp KP_N1         &kp KP_N2     &kp KP_N3        &kp KP_ENTER
                &kp KP_N0                       &kp DOT
            >;
        };

        /*
         * BLE-LAYER (håll NumLock för att komma hit):
         *
         *   NumLock(håll)  BT_NXT      BT_PRV      BT_CLR     <- nästa/förra profil, rensa nuvarande
         *   BT_SEL 0       BT_SEL 1    BT_SEL 2    BT_SEL 3   <- välj profil 0-3
         *   BT_SEL 4       OUT_USB     OUT_BLE     OUT_TOG    <- profil 4, output switch
         *   -              -           -           -
         *   -                          -
         *
         * Typiskt flöde:
         *   1. Håll NumLock + tryck BT_SEL 0  -> ansluter till profil 0 (eller advertise om tom)
         *   2. På datorn: para via Bluetooth-inställningar
         *   3. Byt dator: håll NumLock + BT_SEL 1
         *   4. Behöver para om: håll NumLock + BT_CLR (rensar nuvarande profil), sen para igen
         */
        layer_1 {
            display-name = "BLE";
            bindings = <
                &trans          &bt BT_NXT    &bt BT_PRV    &bt BT_CLR
                &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
                &bt BT_SEL 4    &out OUT_USB  &out OUT_BLE  &out OUT_TOG
                &trans          &trans        &trans        &trans
                &trans                        &trans
            >;
        };

        layer_2 {
            display-name = "Layer 2";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans          &trans
            >;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans          &trans
            >;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans          &trans
            >;
        };
    };
};
