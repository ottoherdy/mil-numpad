#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    /*
     * Fysisk layout för ZMK Studio. Värdena är i centiunit (100 = 1u).
     *
     * Layout (18 knappar, 4 visuella kolumner × 5 visuella rader):
     *   NumLock  /        *        Del
     *   7        8        9        −
     *   4        5        6        +       <- ny rad jämfört med milpad
     *   1        2        3        Enter   (2u höjd, switch i NEDRE halvan)
     *   0 (2u bredd, switch i VÄNSTRA halvan)    .
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Pad V2";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys                              //  w   h    x    y   r  rx  ry
            = <&key_physical_attrs 100 100   0   0   0   0   0>  // NumLock
            , <&key_physical_attrs 100 100 100   0   0   0   0>  // /
            , <&key_physical_attrs 100 100 200   0   0   0   0>  // *
            , <&key_physical_attrs 100 100 300   0   0   0   0>  // Del
            , <&key_physical_attrs 100 100   0 100   0   0   0>  // 7
            , <&key_physical_attrs 100 100 100 100   0   0   0>  // 8
            , <&key_physical_attrs 100 100 200 100   0   0   0>  // 9
            , <&key_physical_attrs 100 100 300 100   0   0   0>  // -
            , <&key_physical_attrs 100 100   0 200   0   0   0>  // 4
            , <&key_physical_attrs 100 100 100 200   0   0   0>  // 5
            , <&key_physical_attrs 100 100 200 200   0   0   0>  // 6
            , <&key_physical_attrs 100 100 300 200   0   0   0>  // +
            , <&key_physical_attrs 100 100   0 300   0   0   0>  // 1
            , <&key_physical_attrs 100 100 100 300   0   0   0>  // 2
            , <&key_physical_attrs 100 100 200 300   0   0   0>  // 3
            , <&key_physical_attrs 100 200 300 300   0   0   0>  // Enter (2u tall)
            , <&key_physical_attrs 200 100   0 400   0   0   0>  // 0 (2u wide)
            , <&key_physical_attrs 100 100 200 400   0   0   0>  // .
            ;
    };

    /*
     * Matristransform — visuell position -> matrisposition (RC).
     *
     *           C0       C1       C2       C3
     *   R0:  NumLock   /         *         Del
     *   R1:  7         8         9         -
     *   R2:  4         5         6         +
     *   R3:  1         2         3         —
     *   R4:  0         —         .         Enter   <- Enter switch är här (nedre halvan)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(4,3)
            RC(4,0)         RC(4,2)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        /*
         * row2col: diodernas KATOD (svart streck) pekar mot KOLUMNEN.
         * Rader = OUTPUT, kolumner = INPUT med pull-down.
         */
        diode-direction = "row2col";
        wakeup-source;

        /*
         * RADER = de RÖDA diod-anod-trådarna (horisontella). OUTPUT.
         * R0 = röd #1 (NumLock, /, *, Del)   -> silk 010 (P0.10)  = pro_micro 16
         *      (flyttad från 006/008 — de är UART-pinnar och kan vara reserverade)
         * R1 = röd #2 (7, 8, 9, -)            -> silk 017 (P0.17)  = pro_micro 2
         * R2 = röd #3 (4, 5, 6, +)            -> silk 020 (P0.20)  = pro_micro 3
         * R3 = röd #4 (1, 2, 3)               -> silk 022 (P0.22)  = pro_micro 4
         * R4 = röd #5 (0, ., Enter)           -> silk 024 (P0.24)  = pro_micro 5
         */
        row-gpios
            = <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 2  GPIO_ACTIVE_HIGH>
            , <&pro_micro 3  GPIO_ACTIVE_HIGH>
            , <&pro_micro 4  GPIO_ACTIVE_HIGH>
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>
            ;

        /*
         * KOLUMNER = de SVARTA icke-diod-trådarna (vertikala). INPUT (pull-down).
         * OBS: kolumnerna är fysiskt wirade i SPEGELVÄND ordning mot vad
         * användaren rapporterade — pinnarna här är i ordning som matchar
         * den faktiska wiringen (verifierad via key-output testning).
         *
         * C0 = svart #1 (NumLock, 7, 4, 1, 0)   -> silk 106 (P1.06)  = pro_micro 9
         * C1 = svart #2 (/, 8, 5, 2)            -> silk 104 (P1.04)  = pro_micro 8
         * C2 = svart #3 (*, 9, 6, 3, .)         -> silk 011 (P0.11)  = pro_micro 7
         * C3 = svart #4 (Del, -, +, Enter)      -> silk 100 (P1.00)  = pro_micro 6
         */
        col-gpios
            = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
