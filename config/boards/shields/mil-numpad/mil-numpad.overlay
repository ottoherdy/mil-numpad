#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    /*
     * Fysisk layout för ZMK Studio. Värdena är i centiunit (100 = 1u).
     * Studio använder detta för att rita keyboardet visuellt i webbläsaren.
     *
     *   w  = bredd        h  = höjd
     *   x  = horisontell  y  = vertikal position
     *   r  = rotation (centidegrees, 0 = ingen rotation)
     *   rx, ry = rotation center
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Mil Numpad";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys                              //  w   h    x    y   r  rx  ry
            = <&key_physical_attrs 100 100   0   0   0   0   0>  // NumLock
            , <&key_physical_attrs 100 100 100   0   0   0   0>  // /
            , <&key_physical_attrs 100 100 200   0   0   0   0>  // *
            , <&key_physical_attrs 100 100 300   0   0   0   0>  // -
            , <&key_physical_attrs 100 100   0 100   0   0   0>  // 7
            , <&key_physical_attrs 100 100 100 100   0   0   0>  // 8
            , <&key_physical_attrs 100 100 200 100   0   0   0>  // 9
            , <&key_physical_attrs 100 200 300 100   0   0   0>  // + (2u tall)
            , <&key_physical_attrs 100 100   0 200   0   0   0>  // 4
            , <&key_physical_attrs 100 100 100 200   0   0   0>  // 5
            , <&key_physical_attrs 100 100 200 200   0   0   0>  // 6
            , <&key_physical_attrs 100 100   0 300   0   0   0>  // 1
            , <&key_physical_attrs 100 100 100 300   0   0   0>  // 2
            , <&key_physical_attrs 100 100 200 300   0   0   0>  // 3
            , <&key_physical_attrs 100 200 300 300   0   0   0>  // Enter (2u tall)
            , <&key_physical_attrs 200 100   0 400   0   0   0>  // 0 (2u wide)
            , <&key_physical_attrs 100 100 200 400   0   0   0>  // .
            ;
    };

    /*
     * MATRIS-IDÉ (matchar din ritning):
     *   "Matrisrad" = de RÖDA horisontella diod-katod-trådarna.
     *                 5 st  -> R0..R4.
     *   "Matriskolumn" = de SVARTA vertikala icke-diod-trådarna.
     *                    4 st -> C0..C3.
     *
     *           C0        C1        C2        C3
     *   R0:  NumLock     /          *         -      <- röd #1 (toppen)
     *   R1:  7           8          9         —      <- röd #2
     *   R2:  4           5          6         +      <- röd #3 (böjer upp till +)
     *   R3:  1           2          3         —      <- röd #4
     *   R4:  0           —          .         Enter  <- röd #5 (böjer upp till Enter)
     *
     *   '—' = ingen switch (täcks av 2u-tangent eller mellanrum).
     *   + sitter i NEDRE halvan av sin 2u-keycap (-> hamnar på R2).
     *   Enter sitter i NEDRE halvan (-> hamnar på R4).
     *   0 sitter i VÄNSTRA halvan av sin 2u-keycap (-> hamnar på C0).
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(2,3)
            RC(2,0) RC(2,1) RC(2,2)
            RC(3,0) RC(3,1) RC(3,2) RC(4,3)
            RC(4,0)         RC(4,2)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        /*
         * row2col: diodernas KATOD (svart streck) pekar mot KOLUMNEN.
         * Strömmen flödar rad -> anod -> katod -> switch -> kolumn.
         * Rader är OUTPUT, kolumner är INPUT med pull-down.
         */
        diode-direction = "row2col";
        wakeup-source;

        /*
         * RADER = de RÖDA diod-anod-trådarna (horisontella). OUTPUT.
         * R0 = röd #1 (NumLock, /, *, -)   -> silk 100 (P1.00)  = pro_micro 6
         * R1 = röd #2 (7, 8, 9)             -> silk 024 (P0.24)  = pro_micro 5
         * R2 = röd #3 (4, 5, 6, +)          -> silk 017 (P0.17)  = pro_micro 2
         * R3 = röd #4 (1, 2, 3)             -> silk 020 (P0.20)  = pro_micro 3
         * R4 = röd #5 (0, ., Enter)         -> silk 022 (P0.22)  = pro_micro 4
         */
        row-gpios
            = <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>
            , <&pro_micro 3 GPIO_ACTIVE_HIGH>
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>
            ;

        /*
         * KOLUMNER = de SVARTA icke-diod-trådarna (vertikala). INPUT (pull-down).
         * C0 = svart #1 (NumLock, 7, 4, 1, 0)   -> silk 010 (P0.10)  = pro_micro 16
         * C1 = svart #2 (/, 8, 5, 2)            -> silk 111 (P1.11)  = pro_micro 14
         * C2 = svart #3 (*, 9, 6, 3, .)         -> silk 113 (P1.13)  = pro_micro 15
         * C3 = svart #4 (-, +, Enter)           -> silk 115 (P1.15)  = pro_micro 18
         */
        col-gpios
            = <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
